[run]
source = classifier
branch = true
omit =
    */__main__.py

[report]
# Hard CI gate, raised 70 -> 80 on 2026-08-19 (actual combined coverage is
# ~96%, well clear of this floor) — see COVERAGE.md and
# .github/workflows/tests.yml. Interim step toward the aspirational 90%
# per-file target; use scripts/check_per_file_coverage.py for that softer,
# report-only per-file check.
fail_under = 80
show_missing = true
skip_covered = false
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
