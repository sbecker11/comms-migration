# Copy to .env and fill in real values. .env is gitignored; this stub is not.

# Anthropic API key, used by classifier/llm_classify.py for the LLM
# fallback categorization pass (only called for senders rules_engine.py
# can't resolve).
# NOTE: python-dotenv does NOT strip inline "#" comments from unquoted
# values — keep the value on its own line with nothing trailing it, or an
# accidental comment becomes part of the "key" and auth fails with a
# confusing 401 instead of a clear "not set" error.
# pragma: allowlist secret
ANTHROPIC_API_KEY=

# Optional overrides
# COMMS_CLASSIFIER_LLM_MODEL=claude-haiku-4-5
# COMMS_CLASSIFIER_RECRUITING_CREDENTIALS=/path/to/client_secret_recruiting.json
# COMMS_CLASSIFIER_PERSONAL_CREDENTIALS=/path/to/client_secret_personal.json
