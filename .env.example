# Copy to .env and fill in real values. .env is tracked but git-crypt
# encrypted at rest (2026-08-19) — see .gitattributes and README.md's
# "Decrypting .env on a new machine". This stub is not encrypted.

# Cursor user API key, used by classifier/llm_classify.py for the Grok
# fallback (only senders rules_engine.py can't resolve). Create one at
# https://cursor.com/dashboard/integrations
# NOTE: python-dotenv does NOT strip inline "#" comments from unquoted
# values — keep the value on its own line with nothing trailing it.
#
# This can also come from the shared workspace-recruiting-automation/.env
# one level up. Only uncomment and set a value here to override that shared
# key (see classifier/__init__.py). An uncommented blank line blocks the
# fallback.
# pragma: allowlist secret
# CURSOR_API_KEY=

# Optional overrides. Unset means grok-4.7 at high effort and fast speed.
# Claude ids are rejected.
# COMMS_CLASSIFIER_LLM_MODEL=grok-4.7
# COMMS_CLASSIFIER_RECRUITING_CREDENTIALS=/path/to/client_secret_recruiting.json
# (personal_hub / COMMS_CLASSIFIER_PERSONAL_CREDENTIALS removed 2026-09-13)
